[Unit]
Description=Second Brain — LLM Finetuning API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/second-brain
ExecStart=%h/Projects/second-brain/.venv/bin/uvicorn app.api:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/Projects/second-brain/logs/api.systemd.log
StandardError=append:%h/Projects/second-brain/logs/api.systemd.log
Environment=PYTHONUNBUFFERED=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda-12.6/lib64
Environment=TRANSFORMERS_CACHE=%h/.cache/huggingface
Environment=HF_HOME=%h/.cache/huggingface

[Install]
WantedBy=default.target
